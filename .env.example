# ── PPM AFM — variabel lingkungan ────────────────────────────────────────────
# Salin ke .env dan sesuaikan.
# WAJIB (aplikasi menolak start tanpa ini): DATABASE_URL, REDIS_URL, JWT_SECRET.
# Saat instalasi BARU di produksi (LEPTOS_ENV=PROD, tabel users kosong):
# ADMIN_PASSWORD juga wajib — admin pertama tak boleh pakai sandi bawaan.

DATABASE_URL=postgres://user:pass@host:5432/ppm
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=ubah-di-produksi   # WAJIB. Token ditandatangani dgn ini.

# ── WAHA (WhatsApp HTTP API) — OTP registrasi + pengingat sesi pamong ─────────
WAHA_BASE_URL=http://localhost:3001   # JANGAN 3000 — itu port aplikasi ini
WAHA_SESSION=default
WAHA_API_KEY=

# ── Base URL publik aplikasi — dipakai di link WA pengingat sesi ─────────────
# Kosong → WA pengingat tetap terkirim tapi tanpa tautan /sesi/{id}.
APP_BASE_URL=https://portal.ppmafm.example

# ── Telegram alert error (opsional) ──────────────────────────────────────────
# Bila keduanya di-set: semua error server/API + WAHA putus dikirim ke Telegram.
# Kosong → fitur alert nonaktif (no-op). admin_chat_id = angka (negatif utk grup).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=0

# ── RustFS (S3) untuk rekaman siaran — opsional (kosong = simpan lokal) ───────
# ENDPOINT = internal app→RustFS (server-to-server). App jalan DI DALAM container,
# jadi "127.0.0.1" = container itu sendiri (SALAH). Pakai gateway host 172.17.0.1
# (RustFS publish 0.0.0.0:9000 ke host). Bucket "ppm" harus di-set public juga:
# `mc anonymous set download <alias>/ppm`.
# RUSTFS_ENDPOINT=http://172.17.0.1:9000
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=
# RUSTFS_BUCKET=ppm
# RUSTFS_PUBLIC_URL=https://image.ulalaapi.store

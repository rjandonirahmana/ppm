# Salin ke .env lalu sesuaikan.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ppm
DB_POOL_MAX_SIZE=16

HOST=0.0.0.0
PORT=3000

# Ganti di produksi (dipakai untuk sign JWT sesi login).
JWT_SECRET=ubah-secret-ini-di-produksi

# Password admin awal (dipakai HANYA saat tabel users kosong → bootstrap admin).
ADMIN_PASSWORD=admin123

RUST_LOG=ppm=info,tower_http=info
